# iHelp environment variables
#
# The deployed app needs exactly these two — both safe to expose because
# Row Level Security is the authority (architecture §9, §12):
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR-ANON-KEY

# LOCAL TOOLING ONLY (scripts/seed.ts). Never set on Vercel; never used by app
# code. With `supabase start` the local values are printed by `supabase status`.
# SUPABASE_SERVICE_ROLE_KEY=YOUR-SERVICE-ROLE-KEY
